{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordered-HDF5 synthetic manifest; no approval for real PCAP or labels",
  "type": "object",
  "properties": {
    "format": {
      "const": "nids-ordered-flow-hdf5"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "input_kind": {
      "const": "synthetic_fixture"
    },
    "processing_view": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Completed synthetic stable ordering index; not a flow tensor dataset",
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "nids-packet-processing-view"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "status": {
          "type": "string",
          "const": "COMPLETE_SYNTHETIC_VIEW"
        },
        "source": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Synthetic packet ordering source contract; not real PCAP approval",
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "1.0.0"
            },
            "input_kind": {
              "type": "string",
              "const": "synthetic_fixture"
            },
            "capture": {
              "type": "object",
              "properties": {
                "capture_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "capture_sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "segment_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              },
              "required": [
                "capture_id",
                "capture_sha256",
                "run_id",
                "segment_id"
              ],
              "additionalProperties": false
            },
            "synthetic_capture_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "source_first_ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "expected_packets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3500000
            },
            "expected_source_order_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "input_complete": {
              "type": "boolean",
              "const": true
            },
            "ordering_policy": {
              "type": "object",
              "const": {
                "id": "stable-packet-processing-view",
                "version": "1.0.0",
                "scope": "SYNTHETIC_TEST_ONLY",
                "sort_keys": [
                  "timestamp_ns",
                  "source_packet_ordinal"
                ],
                "tie_breaker": "SOURCE_ORDINAL_ASCENDING",
                "raw_mutation": false,
                "timestamp_correction": false,
                "default_flow_extractor": "UNCHANGED_CAPTURE_ORDER",
                "real_data_enabled": false
              }
            }
          },
          "required": [
            "schema_version",
            "input_kind",
            "capture",
            "synthetic_capture_text",
            "source_first_ordinal",
            "expected_packets",
            "expected_source_order_sha256",
            "input_complete",
            "ordering_policy"
          ],
          "additionalProperties": false
        },
        "record_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3500000
        },
        "processing_order_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "index": {
          "type": "object",
          "properties": {
            "filename": {
              "type": "string",
              "const": "index.sqlite"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "required": [
            "filename",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "sqlite_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "cache_kib": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "scratch_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "min_free_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "commit_every": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "max_records",
            "sqlite_bytes",
            "cache_kib",
            "scratch_bytes",
            "min_free_bytes",
            "timeout_seconds",
            "commit_every"
          ],
          "additionalProperties": false
        },
        "stats": {
          "type": "object",
          "properties": {
            "source_timestamp_regressions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "max_regression_ns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "moved_records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "min_timestamp_ns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "max_timestamp_ns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "source_timestamp_regressions",
            "max_regression_ns",
            "moved_records",
            "min_timestamp_ns",
            "max_timestamp_ns"
          ],
          "additionalProperties": false
        },
        "labels": {
          "type": "string",
          "const": "NOT_EVALUATED"
        },
        "flow_integration": {
          "type": "string",
          "const": "NOT_ACTIVE"
        },
        "real_data_export": {
          "type": "string",
          "const": "BLOCKED"
        }
      },
      "required": [
        "format",
        "schema_version",
        "status",
        "source",
        "record_count",
        "processing_order_sha256",
        "index",
        "limits",
        "stats",
        "labels",
        "flow_integration",
        "real_data_export"
      ],
      "additionalProperties": false
    },
    "extraction_configuration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Ordered-flow synthetic configuration v2; capture-order defaults unchanged",
      "type": "object",
      "enum": [
        {
          "schema_version": "2.0.0",
          "extractor_version": "lucid-ordered-flow/2.0.0",
          "profile": "flow-cnn-n20-t10",
          "input_kind": "synthetic_fixture",
          "feature_schema_version": "lucid-flow-11/1.0.0-candidate",
          "feature_order": [
            "Time",
            "Packet Length",
            "Higher Protocol",
            "IP Flags",
            "Protocols",
            "TCP Length",
            "TCP Ack",
            "TCP Flags",
            "TCP Window Size",
            "UDP Length",
            "ICMP Type"
          ],
          "tensor_shape": [
            20,
            11,
            1
          ],
          "tensor_dtype": "<f4",
          "mode": "ordered_synthetic_eligible_ipv4_v1",
          "window_ns": 10000000000,
          "window_boundary": "STRICT_GREATER_THAN_ANCHOR_PLUS_T",
          "packet_order": "VERIFIED_PROCESSING_INDEX",
          "regression_policy": "REJECT_PROCESSING_KEY_OR_INDEX_REGRESSION",
          "unsupported_policy": "FAIL_CLOSED",
          "label_policy": "UNKNOWN_ONLY",
          "protocol_vocabulary": {
            "arp": 1,
            "data": 2,
            "dns": 4,
            "ftp": 8,
            "http": 16,
            "icmp": 32,
            "ip": 64,
            "ssdp": 128,
            "ssl": 256,
            "tcp": 512,
            "telnet": 1024,
            "udp": 2048
          },
          "protocol_token_pattern": "(?u)\\b\\w\\w+\\b",
          "highest_layer_encoding": "SHA256_UTF8_CASE_SENSITIVE_MOD_100000000",
          "normalization_version": "lucid-fixed-nominal/1.0.0",
          "normalization_maxima": [
            10,
            65536,
            4294967296,
            65536,
            4096,
            65536,
            4294967296,
            65536,
            65536,
            65536,
            256
          ],
          "normalization_fit": "NONE",
          "padding": "ZERO_AFTER_NORMALIZATION",
          "hardening": "verify view digest and source packet hashes; no ordinal/timestamp edits",
          "ordering_contract_version": "1.0.0",
          "source_ordinal_policy": "PRESERVE_ORIGINAL_NONMONOTONIC",
          "real_data_export": "BLOCKED",
          "HDF5_integration": "NOT_ACTIVE"
        },
        {
          "schema_version": "2.0.0",
          "extractor_version": "lucid-ordered-flow/2.0.0",
          "profile": "paper-table3-n10",
          "input_kind": "synthetic_fixture",
          "feature_schema_version": "lucid-flow-11/1.0.0-candidate",
          "feature_order": [
            "Time",
            "Packet Length",
            "Higher Protocol",
            "IP Flags",
            "Protocols",
            "TCP Length",
            "TCP Ack",
            "TCP Flags",
            "TCP Window Size",
            "UDP Length",
            "ICMP Type"
          ],
          "tensor_shape": [
            10,
            11,
            1
          ],
          "tensor_dtype": "<f4",
          "mode": "ordered_synthetic_eligible_ipv4_v1",
          "window_ns": 10000000000,
          "window_boundary": "STRICT_GREATER_THAN_ANCHOR_PLUS_T",
          "packet_order": "VERIFIED_PROCESSING_INDEX",
          "regression_policy": "REJECT_PROCESSING_KEY_OR_INDEX_REGRESSION",
          "unsupported_policy": "FAIL_CLOSED",
          "label_policy": "UNKNOWN_ONLY",
          "protocol_vocabulary": {
            "arp": 1,
            "data": 2,
            "dns": 4,
            "ftp": 8,
            "http": 16,
            "icmp": 32,
            "ip": 64,
            "ssdp": 128,
            "ssl": 256,
            "tcp": 512,
            "telnet": 1024,
            "udp": 2048
          },
          "protocol_token_pattern": "(?u)\\b\\w\\w+\\b",
          "highest_layer_encoding": "SHA256_UTF8_CASE_SENSITIVE_MOD_100000000",
          "normalization_version": "lucid-fixed-nominal/1.0.0",
          "normalization_maxima": [
            10,
            65536,
            4294967296,
            65536,
            4096,
            65536,
            4294967296,
            65536,
            65536,
            65536,
            256
          ],
          "normalization_fit": "NONE",
          "padding": "ZERO_AFTER_NORMALIZATION",
          "hardening": "verify view digest and source packet hashes; no ordinal/timestamp edits",
          "ordering_contract_version": "1.0.0",
          "source_ordinal_policy": "PRESERVE_ORIGINAL_NONMONOTONIC",
          "real_data_export": "BLOCKED",
          "HDF5_integration": "NOT_ACTIVE"
        }
      ]
    },
    "storage_integration": {
      "const": "ORDERED_SYNTHETIC_ONLY"
    },
    "upstream_marker_policy": {
      "const": "PRESERVE_D2G_D2H_NOT_ACTIVE_MARKERS_AS_PROVENANCE"
    },
    "label_policy": {
      "const": "EXCLUSION_ONLY_NOT_GROUND_TRUTH"
    },
    "allowed_states": {
      "const": [
        "UNKNOWN",
        "MIXED"
      ]
    },
    "y_sentinel": {
      "const": -1
    },
    "supervised_eligible": {
      "const": false
    },
    "real_data_export": {
      "const": "BLOCKED"
    },
    "native_ARM64": {
      "const": "NOT_VERIFIED"
    }
  },
  "required": [
    "format",
    "schema_version",
    "input_kind",
    "processing_view",
    "extraction_configuration",
    "storage_integration",
    "upstream_marker_policy",
    "label_policy",
    "allowed_states",
    "y_sentinel",
    "supervised_eligible",
    "real_data_export",
    "native_ARM64"
  ],
  "additionalProperties": false
}
