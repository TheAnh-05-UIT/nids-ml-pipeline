{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed synthetic stable ordering index; not a flow tensor dataset",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "nids-packet-processing-view"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "const": "COMPLETE_SYNTHETIC_VIEW"
    },
    "source": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Synthetic packet ordering source contract; not real PCAP approval",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "input_kind": {
          "type": "string",
          "const": "synthetic_fixture"
        },
        "capture": {
          "type": "object",
          "properties": {
            "capture_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "capture_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "segment_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          },
          "required": [
            "capture_id",
            "capture_sha256",
            "run_id",
            "segment_id"
          ],
          "additionalProperties": false
        },
        "synthetic_capture_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_first_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expected_packets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3500000
        },
        "expected_source_order_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "input_complete": {
          "type": "boolean",
          "const": true
        },
        "ordering_policy": {
          "type": "object",
          "const": {
            "id": "stable-packet-processing-view",
            "version": "1.0.0",
            "scope": "SYNTHETIC_TEST_ONLY",
            "sort_keys": [
              "timestamp_ns",
              "source_packet_ordinal"
            ],
            "tie_breaker": "SOURCE_ORDINAL_ASCENDING",
            "raw_mutation": false,
            "timestamp_correction": false,
            "default_flow_extractor": "UNCHANGED_CAPTURE_ORDER",
            "real_data_enabled": false
          }
        }
      },
      "required": [
        "schema_version",
        "input_kind",
        "capture",
        "synthetic_capture_text",
        "source_first_ordinal",
        "expected_packets",
        "expected_source_order_sha256",
        "input_complete",
        "ordering_policy"
      ],
      "additionalProperties": false
    },
    "record_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3500000
    },
    "processing_order_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "index": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "const": "index.sqlite"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "filename",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sqlite_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "cache_kib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "scratch_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "min_free_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "commit_every": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "max_records",
        "sqlite_bytes",
        "cache_kib",
        "scratch_bytes",
        "min_free_bytes",
        "timeout_seconds",
        "commit_every"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "properties": {
        "source_timestamp_regressions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "max_regression_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "moved_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "min_timestamp_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "max_timestamp_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "source_timestamp_regressions",
        "max_regression_ns",
        "moved_records",
        "min_timestamp_ns",
        "max_timestamp_ns"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "string",
      "const": "NOT_EVALUATED"
    },
    "flow_integration": {
      "type": "string",
      "const": "NOT_ACTIVE"
    },
    "real_data_export": {
      "type": "string",
      "const": "BLOCKED"
    }
  },
  "required": [
    "format",
    "schema_version",
    "status",
    "source",
    "record_count",
    "processing_order_sha256",
    "index",
    "limits",
    "stats",
    "labels",
    "flow_integration",
    "real_data_export"
  ],
  "additionalProperties": false
}
